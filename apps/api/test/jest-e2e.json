{
  "rootDir": "..",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "moduleFileExtensions": ["js", "json", "ts"],
  "testEnvironment": "node",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "diagnostics": false,
        "tsconfig": {
          "target": "ES2021",
          "module": "commonjs",
          "esModuleInterop": true,
          "experimentalDecorators": true,
          "emitDecoratorMetadata": true
        }
      }
    ]
  }
}
