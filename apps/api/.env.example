# Premium Retail POS — Backend API Environment Configuration
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=4000
HOST=0.0.0.0

# Database Configuration
# For Docker: postgresql://pos_user:pos_password@localhost:5433/retail_pos?schema=public
# For local PostgreSQL: postgresql://postgres:postgres@localhost:5432/retail_pos?schema=public
DATABASE_URL="postgresql://pos_user:pos_password@localhost:5433/retail_pos?schema=public"

# Direct database connection URL (used by Prisma migrations)
# Same as DATABASE_URL but can be different for shadow database in production
SHADOW_DATABASE_URL="postgresql://pos_user:pos_password@localhost:5433/retail_pos_shadow?schema=public"

# JWT Configuration
JWT_SECRET=generate-with-openssl-rand-base64-32-or-node-crypto
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=generate-different-secret-for-refresh-tokens
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Bcrypt Configuration
BCRYPT_ROUNDS=12

# QR Code Signing (Attendance Module - Phase 8)
QR_SIGNING_SECRET=your-secure-qr-secret-min-32-chars-long

# Idempotency Configuration
IDEMPOTENCY_TTL_HOURS=24

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=api
SWAGGER_TITLE=Premium Retail POS API
SWAGGER_VERSION=0.1.0

# Session Configuration (if using sessions)
SESSION_SECRET=your-session-secret-different-from-jwt

# Audit Log Configuration
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# File Upload Limits
MAX_FILE_SIZE_MB=10

# Prisma Configuration
PRISMA_QUERY_LOG=false
PRISMA_INFO_LOG=true
PRISMA_WARN_LOG=true
PRISMA_ERROR_LOG=true

# Performance Monitoring
ENABLE_QUERY_LOGGING=false
SLOW_QUERY_THRESHOLD_MS=1000

# Security Headers
HELMET_ENABLED=true
TRUST_PROXY=false

# Redis (Future - for caching, sessions, and idempotency)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
# REDIS_TLS=false

# Email/SMS (Future - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMS_API_KEY=
# SMS_SENDER_ID=

# Cloud Storage (Future - for receipts, reports)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=

# Sentry (Production Error Tracking)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
