# Premium Retail POS — Frontend Web Application Environment Configuration
# Copy this file to .env.local (Next.js convention)

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# WebSocket Configuration (Future - for real-time updates)
# NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Application Configuration
NEXT_PUBLIC_APP_NAME=Premium Retail POS
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_COMPANY_NAME=Your Company Name

# Feature Flags
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
NEXT_PUBLIC_ENABLE_BARCODE_SCANNER=true
NEXT_PUBLIC_ENABLE_THERMAL_PRINT=true

# Offline Storage Configuration
NEXT_PUBLIC_INDEXED_DB_NAME=pos_offline_db
NEXT_PUBLIC_INDEXED_DB_VERSION=1
NEXT_PUBLIC_MAX_OFFLINE_QUEUE_SIZE=100

# Session Configuration
NEXT_PUBLIC_TOKEN_STORAGE=localStorage
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=480

# POS Configuration
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
NEXT_PUBLIC_DECIMAL_PLACES=2

# Barcode Scanner Configuration
NEXT_PUBLIC_SCANNER_PREFIX=
NEXT_PUBLIC_SCANNER_SUFFIX=Enter
NEXT_PUBLIC_SCANNER_TIMEOUT_MS=100

# Thermal Printer Configuration (Future)
# NEXT_PUBLIC_PRINTER_WIDTH=80
# NEXT_PUBLIC_PRINTER_ENCODING=UTF-8
# NEXT_PUBLIC_PRINTER_PAPER_TYPE=thermal

# Geolocation Configuration (Attendance Module)
NEXT_PUBLIC_ENABLE_GEOLOCATION=true
NEXT_PUBLIC_GEOLOCATION_TIMEOUT=10000
NEXT_PUBLIC_GEOLOCATION_MAX_AGE=0

# Analytics (Future)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_HOTJAR_ID=

# Error Tracking (Production)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Development Tools
NEXT_PUBLIC_SHOW_DEBUG_INFO=true
NEXT_PUBLIC_ENABLE_REDUX_DEVTOOLS=true

# Performance Monitoring
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=false

# Pagination Defaults
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_PAGE_SIZE=100

# Notification Configuration
NEXT_PUBLIC_TOAST_DURATION=5000
NEXT_PUBLIC_ENABLE_SOUND_ALERTS=true

# Server-side Configuration (NOT exposed to browser)
# These are only available in server-side code and API routes
API_SECRET_KEY=your-backend-api-secret-for-server-side-calls
INTERNAL_API_URL=http://localhost:4000/api/v1
