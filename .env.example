# Premium Retail POS — Root Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real secrets to version control

# Node Environment
NODE_ENV=development

# Application Ports
API_PORT=4000
WEB_PORT=3000

# Database Configuration
# Local Docker PostgreSQL (docker-compose.yml)
DATABASE_URL="postgresql://pos_admin:pos_dev_secret@localhost:5433/retail_pos?schema=public"

# JWT Authentication
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your-super-secure-refresh-token-secret-change-this
JWT_REFRESH_EXPIRES_IN=7d

# Initial administrator bootstrap (only used by `npm run db:seed --workspace=apps/api`)
# Choose a unique email and a strong password, then run the seed once.
# The bootstrap creates only this Super Admin; create companies, locations, and
# additional roles after signing in. Never commit real values to this file.
INITIAL_SUPER_ADMIN_EMAIL=superadmin@yourcompany.example
INITIAL_SUPER_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-14-characters

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_MS=60000
CORS_CREDENTIALS=true

# QR Code Signing (for Attendance Module)
QR_SIGNING_SECRET=your-secure-qr-signing-secret-change-this

# Session Configuration
SESSION_SECRET=your-secure-session-secret-change-this

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# Company Configuration (Optional defaults)
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_INVOICE_PREFIX=INV

# Redis (Future - for caching and idempotency)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Email Configuration (Future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-app-password

# File Upload Configuration (Future)
# MAX_FILE_SIZE=5242880
# UPLOAD_PATH=./uploads

# Sentry Error Tracking (Production)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=false
